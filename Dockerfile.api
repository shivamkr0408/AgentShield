# AgentShield backend API.
FROM python:3.11-slim

WORKDIR /app
ENV PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1

COPY pyproject.toml ./
COPY agents ./agents
COPY api ./api
COPY shield ./shield
COPY eval ./eval
COPY dataset ./dataset
COPY config ./config
COPY data ./data

RUN pip install --upgrade pip && pip install -e .

ENV AGENTSHIELD_MODEL_URL=http://ollama:11434 \
    AGENTSHIELD_MODEL_NAME=qwen2.5:7b \
    AGENTSHIELD_DB_URL=sqlite:////state/agentshield.db

EXPOSE 8000
CMD ["uvicorn", "api.main:app", "--host", "0.0.0.0", "--port", "8000"]
